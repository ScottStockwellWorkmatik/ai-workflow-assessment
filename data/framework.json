 "questions": [
  {
   "id": "V1",
   "group": "value",
   "name": "Business impact",
   "q": "If this workflow ran much better, how much would it move a result that matters, such as pipeline, revenue, cost, speed or quality?",
   "a": [
    "Little or no effect on results",
    "Noticeable effect on one result",
    "Clear, large effect on a key result"
   ]
  },
  {
   "id": "V2",
   "group": "value",
   "name": "Effort and volume",
   "q": "How much time and effort does this workflow take across the team?",
   "a": [
    "Run rarely, small effort",
    "Run regularly, moderate effort",
    "Run constantly, a large share of team time"
   ]
  },
  {
   "id": "F1",
   "group": "feasibility",
   "name": "Repeatability",
   "q": "How consistent are the steps and outputs from one run to the next?",
   "a": [
    "Different every time, mostly judgement",
    "Some standard steps, some variation",
    "Same steps and outputs every run"
   ]
  },
  {
   "id": "F2",
   "group": "feasibility",
   "name": "Data and content readiness",
   "q": "Are the inputs (data, content, briefs, brand material) available, accurate and accessible to AI tools?",
   "a": [
    "Scattered, poor or inaccessible",
    "Mostly available, with gaps",
    "Complete, clean and accessible"
   ]
  },
  {
   "id": "F3",
   "group": "feasibility",
   "name": "Tool and integration readiness",
   "q": "Are suitable AI-capable tools in place, or easy to add and connect to your current systems?",
   "a": [
    "No suitable tools, hard to integrate",
    "Tools exist but need setup or integration",
    "Tools in place and connected"
   ]
  },
  {
   "id": "R1",
   "group": "risk",
   "name": "Consequence of an error",
   "q": "If AI got a step wrong and nobody caught it, how serious would the consequence be?",
   "a": [
    "Minor, easy to fix internally",
    "Noticeable: rework, wasted spend or some reputational effect",
    "Serious: legal, financial or major brand harm"
   ]
  },
  {
   "id": "R2",
   "group": "risk",
   "name": "Data sensitivity",
   "q": "How sensitive is the data or content this workflow handles?",
   "a": [
    "Public or non-sensitive",
    "Internal or business-confidential",
    "Personal, client-confidential or regulated"
   ]
  }
 ],
