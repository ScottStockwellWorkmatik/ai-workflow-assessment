  {
   "id": "high",
   "name": "High-risk",
   "text": "AI supports decisions about people in areas the Act lists, such as recruitment, worker management, education or access to essential services."
  },
  {
   "id": "prohibited",
   "name": "Prohibited",
   "text": "Uses a practice the Act bans, such as manipulating people, social scoring, or inferring employees' emotions."
